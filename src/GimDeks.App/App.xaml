<Application x:Class="GimDeks.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:GimDeks.App.Views"
            StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Teal" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="GimDeksTileTeal" Color="#2EE6C5" />
            <SolidColorBrush x:Key="GimDeksInk" Color="#0F1226" />
            <SolidColorBrush x:Key="GimDeksAmber" Color="#FFB020" />
            <SolidColorBrush x:Key="GimDeksSidebar" Color="#151C1A" />
            <views:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <views:CountToVisibilityInverseConverter x:Key="CountToVisibilityInverseConverter" />
            <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <views:GameIdToCoverConverter x:Key="GameIdToCoverConverter" />
            <views:LocKeyConverter x:Key="LocKeyConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style TargetType="UserControl">
                <Style.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Duration="0:0:0.18" From="0" To="1" Storyboard.TargetProperty="Opacity" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
