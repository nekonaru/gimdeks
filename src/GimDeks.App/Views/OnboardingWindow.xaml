<Window x:Class="GimDeks.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="GimDeks" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <StackPanel Margin="24">
        <TextBlock Text="{DynamicResource Ui_Onboard_Title}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Ui_Onboard_Intro}" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,18" />
        <TextBlock Text="{DynamicResource Ui_Onboard_Language}" Opacity="0.8" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,18">
            <RadioButton x:Name="IndonesianRadio" Content="Bahasa Indonesia" IsChecked="True" Margin="0,0,20,0" />
            <RadioButton x:Name="EnglishRadio" Content="English" />
        </StackPanel>
        <TextBlock Text="{DynamicResource Ui_Onboard_Offline}" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,18" />
        <Button Content="{DynamicResource Ui_Onboard_Start}" Style="{StaticResource MaterialDesignRaisedButton}"
                HorizontalAlignment="Right" Click="StartButton_OnClick" />
    </StackPanel>
</Window>
