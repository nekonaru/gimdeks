<Window x:Class="GimDeks.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:GimDeks.App.ViewModels"
        xmlns:views="clr-namespace:GimDeks.App.Views"
        Title="{Binding TitleText}"
        Width="1280"
        Height="800"
        MinWidth="1200"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        AllowDrop="True"
        DragEnter="Window_OnDragEnter"
        DragLeave="Window_OnDragLeave"
        Drop="Window_OnDrop"
        Icon="pack://siteoforigin:,,,/assets/gimdeks-mark.png">
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="F" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="I" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.ImportExport}" />
        <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding ExportCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding AddGameCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="T" Command="{Binding ToggleThemeCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="K" Command="{Binding ToggleSelesaiCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Dashboard}" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.GameList}" />
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Storage}" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Dikecualikan}" />
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Dieliminasi}" />
        <KeyBinding Modifiers="Ctrl" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Duplicates}" />
        <KeyBinding Modifiers="Ctrl" Key="D7" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.SaranHdd}" />
        <KeyBinding Modifiers="Ctrl" Key="D8" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.ImportExport}" />
        <KeyBinding Modifiers="Ctrl" Key="D9" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Statistics}" />
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding OpenPaletteCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="M" Command="{Binding OpenMiniCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameListViewModel}">
            <views:GameListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageViewModel}">
            <views:StoragePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExcludedViewModel}">
            <views:StatusListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EliminatedViewModel}">
            <views:StatusListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportExportViewModel}">
            <views:ImportExportPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}">
            <views:DuplicatesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HealthViewModel}">
            <views:HealthPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanGamesViewModel}">
            <views:ScanGamesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupManagerViewModel}">
            <views:BackupManagerPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
            <views:ActivityPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HddSuggestionViewModel}">
            <views:HddSuggestionPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource GimDeksSidebarGradient}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,4,4,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource GimDeksCardGradient}" Padding="5">
                            <Image Source="pack://siteoforigin:,,,/assets/gimdeks-mark.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="GimDeks" FontSize="24" FontWeight="Bold" Foreground="#EAF4EC" />
                            <TextBlock Text="{DynamicResource Ui_App_Subtitle}" FontSize="11" Foreground="#8CA89B" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavItemsView}"
                         SelectedValue="{Binding CurrentPage, Mode=OneWay}"
                         SelectedValuePath="Page"
                         SelectionChanged="NavList_OnSelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name, Converter={StaticResource LocKeyConverter}}"
                                               FontSize="10" FontWeight="SemiBold" Opacity="0.5"
                                               Margin="14,12,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8,1">
                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="22" Height="22" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="#8CA89B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource GimDeksTileTeal}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#D5E5DC"
                                           Text="{Binding LabelKey, Converter={StaticResource LocKeyConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding LabelKey, Converter={StaticResource LocKeyConverter}}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccentBorder" Grid.Column="0" CornerRadius="2"
                                                    Background="Transparent" Margin="0,8" VerticalAlignment="Stretch" />
                                            <Border x:Name="Root" Grid.Column="1" CornerRadius="10" Background="Transparent"
                                                    BorderThickness="0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource GimDeksAccentSoft}" />
                                                <Setter TargetName="AccentBorder" Property="Background" Value="{StaticResource GimDeksAccentLine}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource GimDeksCardAlt}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="8,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ToggleThemeCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Left"
                                Padding="8,4"
                                AutomationProperties.Name="{DynamicResource Ui_Theme_Toggle}"
                                ToolTip="{DynamicResource Ui_Theme_Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center"
                                                         Kind="WeatherNight" />
                                <TextBlock FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Text="{DynamicResource Ui_Theme_Toggle}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleLanguageCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Padding="8,4"
                                Margin="4,0,0,0"
                                AutomationProperties.Name="{DynamicResource Ui_Language_Tooltip}"
                                ToolTip="{DynamicResource Ui_Language_Tooltip}">
                            <TextBlock Text="{Binding LanguageLabel}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding AppVersionText}" FontSize="11" Opacity="0.5" Margin="0,6,0,0" />
                    <TextBlock Text="{DynamicResource Ui_OfflineFooter}" FontSize="10" Opacity="0.4" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#2A2210"
                    BorderBrush="#FFB020" BorderThickness="0,0,0,1"
                    Visibility="{Binding ShowExcelChangedBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Margin="12,8" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileAlert" Width="18" Height="18" Foreground="#FFB020" VerticalAlignment="Center" />
                    <TextBlock Margin="10,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="{DynamicResource Ui_ExcelChanged_Text}" />
                    <Button Content="{DynamicResource Ui_ExcelChanged_ImportNow}" Style="{StaticResource MaterialDesignRaisedButton}"
                            Padding="12,3" Margin="0,0,8,0" Command="{Binding ImportNowCommand}" />
                    <Button Content="{DynamicResource Ui_ExcelChanged_Dismiss}" Style="{StaticResource MaterialDesignFlatButton}"
                            Padding="12,3" Command="{Binding DismissExcelChangedCommand}" />
                </StackPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="0" />

            <Border Grid.Row="2" Background="{StaticResource GimDeksSidebarGradient}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}" BorderThickness="0,1,0,0">
                <Grid Margin="14,4" Height="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusBarText}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource Ui_StatusBar_Storage}" Opacity="0.35" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="2" Text="{Binding ShortcutHintText}" Opacity="0.6" FontSize="10" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource GimDeksHeroGradient}"
                Visibility="{Binding IsDropTargetActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                AllowDrop="True"
                DragOver="Overlay_OnDragOver"
                DragLeave="Overlay_OnDragLeave"
                Drop="Window_OnDrop">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="FileExcel" Width="84" Height="84" HorizontalAlignment="Center" Foreground="#2EE6C5" />
                <TextBlock Text="{DynamicResource Ui_Drop_Title}" FontSize="26" FontWeight="Bold" Margin="0,12,0,6" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource Ui_Drop_Body}" FontSize="14" Opacity="0.8" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>





