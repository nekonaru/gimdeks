<Window x:Class="GimDeks.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:GimDeks.App.ViewModels"
        xmlns:views="clr-namespace:GimDeks.App.Views"
        Title="GimDeks"
        Width="1280"
        Height="800"
        MinWidth="1200"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Icon="pack://siteoforigin:,,,/assets/gimdeks-mark.png">
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="F" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="I" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.ImportExport}" />
        <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding ExportCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding AddGameCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="T" Command="{Binding ToggleThemeCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Dashboard}" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.GameList}" />
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Storage}" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Dikecualikan}" />
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Dieliminasi}" />
        <KeyBinding Modifiers="Ctrl" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Duplicates}" />
        <KeyBinding Modifiers="Ctrl" Key="D7" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.SaranHdd}" />
        <KeyBinding Modifiers="Ctrl" Key="D8" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.ImportExport}" />
        <KeyBinding Modifiers="Ctrl" Key="D9" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Statistics}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameListViewModel}">
            <views:GameListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageViewModel}">
            <views:StoragePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExcludedViewModel}">
            <views:StatusListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EliminatedViewModel}">
            <views:StatusListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportExportViewModel}">
            <views:ImportExportPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}">
            <views:DuplicatesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HddSuggestionViewModel}">
            <views:HddSuggestionPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource GimDeksSidebar}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,4,4,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://siteoforigin:,,,/assets/gimdeks-mark.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="GimDeks" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text="Koleksi game kamu" FontSize="11" Opacity="0.65" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavItems}"
                         SelectedValue="{Binding CurrentPage, Mode=TwoWay}"
                         SelectedValuePath="Page"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="6,2">
                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Accent" Grid.Column="0" CornerRadius="2"
                                                    Background="Transparent" Margin="0,6" VerticalAlignment="Stretch" />
                                            <Border x:Name="Root" Grid.Column="1" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#20332E" />
                                                <Setter TargetName="Accent" Property="Background" Value="#2EE6C5" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#243B34" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="8,12">
                    <Button Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Left"
                            Padding="8,4"
                            ToolTip="Ganti tema gelap/terang">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center"
                                                     Kind="WeatherNight" />
                            <TextBlock FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="Ganti Tema" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="GimDeks v1.1.0" FontSize="11" Opacity="0.5" Margin="0,6,0,0" />
                    <TextBlock Text="Offline | Data di %LOCALAPPDATA%\GimDeks" FontSize="10" Opacity="0.4" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#2A2210"
                    BorderBrush="#FFB020" BorderThickness="0,0,0,1"
                    Visibility="{Binding ShowExcelChangedBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Margin="12,8" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileAlert" Width="18" Height="18" Foreground="#FFB020" VerticalAlignment="Center" />
                    <TextBlock Margin="10,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="File Excel yang diimport sudah berubah di luar aplikasi. Impor ulang?" />
                    <Button Content="Impor Sekarang" Style="{StaticResource MaterialDesignRaisedButton}"
                            Padding="12,3" Margin="0,0,8,0" Command="{Binding ImportNowCommand}" />
                    <Button Content="Abaikan" Style="{StaticResource MaterialDesignFlatButton}"
                            Padding="12,3" Command="{Binding DismissExcelChangedCommand}" />
                </StackPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="0" />

            <Border Grid.Row="2" Background="{StaticResource GimDeksSidebar}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}" BorderThickness="0,1,0,0">
                <Grid Margin="14,4" Height="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusBarText}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Data di %LOCALAPPDATA% / folder aplikasi" Opacity="0.35" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="2" Text="{Binding ShortcutHintText}" Opacity="0.6" FontSize="10" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>




