<Window x:Class="GimDeks.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:GimDeks.App.ViewModels"
        xmlns:views="clr-namespace:GimDeks.App.Views"
        Title="GimDeks"
        Width="1280"
        Height="800"
        MinWidth="1080"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Icon="pack://siteoforigin:,,,/assets/gimdeks-mark.png">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameListViewModel}">
            <views:GameListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageViewModel}">
            <views:StoragePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExcludedViewModel}">
            <views:StatusListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EliminatedViewModel}">
            <views:StatusListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportExportViewModel}">
            <views:ImportExportPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}">
            <views:DuplicatesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HddSuggestionViewModel}">
            <views:HddSuggestionPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
                BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,4,4,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://siteoforigin:,,,/assets/gimdeks-mark.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="GimDeks" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text="Koleksi game kamu" FontSize="11" Opacity="0.65" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavItems}"
                         SelectedValue="{Binding CurrentPage, Mode=TwoWay}"
                         SelectedValuePath="Page"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="6,2">
                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#20332E" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#243B34" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="8,12">
                    <Button Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Left"
                            Padding="8,4"
                            ToolTip="Ganti tema gelap/terang">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center"
                                                     Kind="WeatherNight" />
                            <TextBlock FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="Ganti Tema" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="GimDeks v1.0.0" FontSize="11" Opacity="0.5" Margin="0,6,0,0" />
                    <TextBlock Text="Offline | Data di %LOCALAPPDATA%\GimDeks" FontSize="10" Opacity="0.4" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="0" />
    </Grid>
</Window>


