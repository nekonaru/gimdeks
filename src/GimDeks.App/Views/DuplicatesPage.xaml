<UserControl x:Class="GimDeks.App.Views.DuplicatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GimDeks.App.ViewModels"
             x:Name="Root">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Duplikat" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Nama yang sama setelah huruf besar-kecil dan nomor versi diabaikan. Per grup, game pertama (urutan paling awal) dipertahankan."
                       Opacity="0.7" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Opacity="0.8" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DuplicateGroup}">
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Hapus Duplikat" Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#FF8A8A" BorderBrush="#FF8A8A" Padding="10,3"
                                                Command="{Binding DataContext.DeleteDuplicatesCommand, ElementName=Root}"
                                                CommandParameter="{Binding}" Margin="0,0,8,0" />
                                        <Button Content="Eliminasi Duplikat" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="10,3"
                                                Command="{Binding DataContext.EliminateDuplicatesCommand, ElementName=Root}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Members}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DuplicateMember}">
                                            <Grid Margin="0,2,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="4" Padding="4,1" Background="#20332E"
                                                        Visibility="{Binding IsKeeper, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="SIMPAN" FontSize="9" FontWeight="Bold" Foreground="#2EE6C5" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Game.Nama}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding UkuranText}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding StorageName}" VerticalAlignment="Center" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.85" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="Duplikat dihapus tidak masuk riwayat; backup sebelum import tetap ada di folder backups."
                   Opacity="0.5" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
