<UserControl x:Class="GimDeks.App.Views.StatusListPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
            <Button Content="Pulihkan ke Storage..." Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding RestoreSelectedCommand}" Margin="0,0,8,0" />
            <Button Content="Hapus" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding DeleteSelectedCommand}"
                    Foreground="#FF8A8A" BorderBrush="#FF8A8A" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.8" Margin="12,0,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#1F2A28"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#121A18"
                  HeadersVisibility="Column"
                  SelectionChanged="DataGrid_OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nama Game" Binding="{Binding Game.Nama}" Width="*" />
                <DataGridTextColumn Header="Ukuran (GB)" Binding="{Binding Game.UkuranGb, StringFormat=N1}" Width="110" />
                <DataGridTemplateColumn x:Name="AlasanColumn" Header="Detail" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StorageName}" TextWrapping="Wrap" VerticalAlignment="Center" Padding="3,6" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding SummaryText}" Opacity="0.7" Margin="2,8,0,0" FontSize="12" />
    </Grid>
</UserControl>
