<UserControl x:Class="GimDeks.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GimDeks.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <TextBlock Text="{DynamicResource Ui_Dashboard_Title}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Ui_Dashboard_Subtitle}"
                       Opacity="0.7" Margin="0,2,0,18" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Background="{StaticResource GimDeksCardAltGradient}" CornerRadius="14" Padding="18,14" Margin="0,0,12,0" MinWidth="170" BorderThickness="0,1,0,0" BorderBrush="{StaticResource GimDeksTileTeal}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Ui_Dashboard_TotalGames}" FontSize="11" Foreground="#8CA89B" />
                        <TextBlock Text="{Binding TotalGamesText}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0" Foreground="#EAF4EC" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource GimDeksCardAltGradient}" CornerRadius="14" Padding="18,14" Margin="0,0,12,0" MinWidth="170" BorderThickness="0,1,0,0" BorderBrush="#FFB020">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Ui_Dashboard_TotalSize}" FontSize="11" Foreground="#8CA89B" />
                        <TextBlock Text="{Binding TotalSizeText}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0" Foreground="#EAF4EC" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource GimDeksCardAltGradient}" CornerRadius="14" Padding="18,14" MinWidth="230" BorderThickness="0,1,0,0" BorderBrush="#FFB020">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Ui_Dashboard_OtherStatus}" FontSize="11" Foreground="#8CA89B" />
                        <TextBlock Text="{Binding ExcludedText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="#EAF4EC" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Background="{StaticResource GimDeksCardGradient}" CornerRadius="14" Padding="18" Margin="0,0,0,20"
                    Visibility="{Binding HasAnyGames, Converter={StaticResource BooleanToVisibilityConverter}}"
                    BorderThickness="0,1,0,0" BorderBrush="{StaticResource GimDeksTileTeal}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Ui_Dashboard_PickRandom}" FontSize="16" FontWeight="SemiBold" Foreground="#EAF4EC" />
                        <TextBlock Text="{DynamicResource Ui_Dashboard_PickRandomHint}" FontSize="12" Foreground="#8CA89B" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#2EE6C5" Margin="0,6,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding PickRandomGameCommand}"
                            AutomationProperties.Name="{DynamicResource Ui_Dashboard_PickRandom}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DiceMultiple" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Ui_Dashboard_PickRandom}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Storages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StorageCardItem}">
                        <Button Cursor="Hand"
                                Style="{x:Null}"
                                Background="{StaticResource GimDeksCardGradient}"
                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                Padding="18"
                                Width="300"
                                Margin="0,0,14,14"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{StaticResource GimDeksTileTeal}"
                                Command="{Binding DataContext.OpenStorageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Storage.Nama}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="14" Padding="{TemplateBinding Padding}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            TextElement.Foreground="{TemplateBinding Foreground}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TipeLabel}" FontSize="10" Opacity="0.55" />
                                            <TextBlock Text="{Binding Storage.Nama}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DriveDisconnectedText}" FontSize="11" Foreground="#FFB020"
                                                       Visibility="{Binding DriveDisconnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                Background="#FFB020" CornerRadius="6" Padding="6,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{DynamicResource Ui_Dashboard_OverBadge}" FontSize="10" FontWeight="Bold" Foreground="#1F1300" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding TotalText}" FontSize="30" FontWeight="Bold" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding CapacityText}" FontSize="11" Opacity="0.6" />
                                    <ProgressBar Value="{Binding ProgressFraction, Mode=OneWay}" Maximum="1"
                                                 Height="6" Margin="0,12,0,10"
                                                 Background="#1E2A26">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Foreground" Value="#2EE6C5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFB020" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasLimit}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <Grid>
                                        <TextBlock Text="{Binding GameCountText}" FontSize="12" Opacity="0.8" />
                                        <TextBlock Text="{Binding RemainingText}" FontSize="12" Opacity="0.8" HorizontalAlignment="Right" />
                                    </Grid>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Visibility="{Binding Storages.Count, Converter={StaticResource CountToVisibilityConverter}}" Margin="4,24,0,0" HorizontalAlignment="Center">
                <Image Source="pack://siteoforigin:,,,/assets/gimdeks-lockup-teal.png" Width="250" Opacity="0.9" Margin="0,0,0,16" />
                <TextBlock Text="{DynamicResource Ui_Dashboard_Empty}" Opacity="0.75" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" />
                <Button Content="{DynamicResource Ui_Dashboard_ImportNow}" Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Center" Padding="18,8" FontSize="14" Margin="0,16,0,0"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{x:Static vm:Page.ImportExport}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
