<UserControl x:Class="GimDeks.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GimDeks.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Ringkasan kapasitas semua storage. Klik kartu untuk membuka daftar gamenya."
                       Opacity="0.7" Margin="0,2,0,18" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                        CornerRadius="12" Padding="18,14" Margin="0,0,12,0" MinWidth="170">
                    <StackPanel>
                        <TextBlock Text="TOTAL GAME" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{Binding TotalGamesText}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                        CornerRadius="12" Padding="18,14" Margin="0,0,12,0" MinWidth="170">
                    <StackPanel>
                        <TextBlock Text="TOTAL UKURAN" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{Binding TotalSizeText}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                        CornerRadius="12" Padding="18,14" MinWidth="230">
                    <StackPanel>
                        <TextBlock Text="STATUS LAIN" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{Binding ExcludedText}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Storages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StorageCardItem}">
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                CornerRadius="14" Padding="18" Width="300" Margin="0,0,14,14"
                                Cursor="Hand"
                                TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.OpenStorageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TipeLabel}" FontSize="10" Opacity="0.55" />
                                            <TextBlock Text="{Binding Storage.Nama}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                Background="#FFB020" CornerRadius="6" Padding="6,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Melebihi batas" FontSize="10" FontWeight="Bold" Foreground="#1F1300" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding TotalText}" FontSize="30" FontWeight="Bold" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding CapacityText}" FontSize="11" Opacity="0.6" />
                                    <ProgressBar Value="{Binding ProgressFraction}" Maximum="1"
                                                 Height="6" Margin="0,12,0,10"
                                                 Background="#1E2A26">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Foreground" Value="#2EE6C5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFB020" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasLimit}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <Grid>
                                        <TextBlock Text="{Binding GameCountText}" FontSize="12" Opacity="0.8" />
                                        <TextBlock Text="{Binding RemainingText}" FontSize="12" Opacity="0.8" HorizontalAlignment="Right" />
                                    </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Belum ada storage. Import file Excel kamu dari menu Import / Export."
                       Opacity="0.6" FontSize="13" Margin="4,8,0,0"
                       Visibility="{Binding Storages.Count, Converter={StaticResource CountToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
