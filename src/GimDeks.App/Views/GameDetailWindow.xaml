<Window x:Class="GimDeks.App.Views.GameDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:GimDeks.App.ViewModels"
        Title="{Binding HeaderText}" Width="680" Height="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource MaterialDesign.Brush.Background}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="150" Height="90" CornerRadius="10" Background="#121A18" Margin="0,0,16,0">
                <Image Source="{Binding Game.Id, Converter={StaticResource GameIdToCoverConverter}}" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Game.Nama}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Game.Versi}" Opacity="0.7" />
                <TextBlock Text="{Binding Game.UkuranGb, StringFormat=N1}" Opacity="0.7" />
                <TextBlock Text="{Binding Game.Catatan}" TextWrapping="Wrap" Opacity="0.8" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource Ui_Detail_Notes}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NoteView}">
                            <Border Background="{StaticResource GimDeksCard}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Note.Isi}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TimeText}" FontSize="10" Opacity="0.55" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{DynamicResource Ui_Button_Delete}" Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Padding="8,2" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,6,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource Ui_Detail_NoteHint}" />
                    <Button Grid.Column="1" Content="{DynamicResource Ui_Detail_AddNote}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding AddNoteCommand}" Margin="8,0,0,0" />
                </Grid>

                <TextBlock Text="{DynamicResource Ui_Detail_Sessions}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,8" />
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SessionView}">
                            <Border Background="{StaticResource GimDeksCard}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StartText}" Width="150" />
                                    <TextBlock Text="{Binding DurationText}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="{DynamicResource Ui_Button_Launch}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding LaunchCommand}" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Ui_Detail_OpenFolder}" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Ui_Button_Close}" Style="{StaticResource MaterialDesignFlatButton}"
                    Click="CloseButton_OnClick" HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</Window>
