<UserControl x:Class="GimDeks.App.Views.ImportExportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GimDeks.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock Text="{DynamicResource Ui_Import_Title}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Ui_Import_Subtitle}"
                       Opacity="0.7" Margin="0,2,0,16" />

            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Ui_Import_Section}" FontSize="11" Opacity="0.6" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Ui_Import_PathHint}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="{DynamicResource Ui_Import_Browse}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding BrowseCommand}" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="{DynamicResource Ui_Import_Mode}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="150"
                                  ItemsSource="{Binding ImportModes}"
                                  SelectedItem="{Binding SelectedMode}"
                                  DisplayMemberPath="Label" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{DynamicResource Ui_Import_Preview}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding PreviewCommand}" Margin="0,0,10,0" />
                        <Button Content="{DynamicResource Ui_Import_Diff}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding PreviewDiffCommand}" Margin="0,0,10,0" />
                        <Button Content="{DynamicResource Ui_Import_Incremental}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding ImportIncrementalCommand}" Margin="0,0,10,0" />
                        <Button Content="{DynamicResource Ui_ExcelChanged_ImportNow}" Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding ImportCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DiffText}" Opacity="0.7" Margin="0,6,0,0" />

                    <ProgressBar Height="4" Margin="0,12,0,8" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusText}" Opacity="0.8" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding PreviewSummary}" FontWeight="SemiBold" Margin="0,12,0,4" />

                    <ItemsControl ItemsSource="{Binding SkippedSheets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., StringFormat='Dilewati: {0}'}" Opacity="0.7" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#FFB020" FontSize="12" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DataGrid ItemsSource="{Binding RingkasanRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="Transparent"
                              Margin="0,8,0,0"
                              MaxHeight="260"
                              Visibility="{Binding RingkasanRows.Count, Converter={StaticResource CountToVisibilityInverseConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Ui_Import_SheetColumn}" Binding="{Binding Label}" Width="*" />
                            <DataGridTextColumn Header="{DynamicResource Ui_Import_ExpectedColumn}" Binding="{Binding ExpectedText}" Width="170" />
                            <DataGridTextColumn Header="{DynamicResource Ui_Import_ActualColumn}" Binding="{Binding ActualText}" Width="170" />
                            <DataGridTextColumn Header="{DynamicResource Ui_Import_ResultColumn}" Binding="{Binding ResultText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Ui_Import_ModePortable}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding PortableStatusText}" Opacity="0.75" Margin="0,6,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Ui_Import_PortableEnable}" Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding EnablePortableCommand}" Margin="0,0,10,0"
                                Visibility="{Binding IsPortable, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <Button Content="{DynamicResource Ui_Import_PortableDisable}" Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding DisablePortableCommand}"
                                Visibility="{Binding IsPortable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Ui_Import_SectionIO}" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{DynamicResource Ui_Import_IoDescription}"
                               Opacity="0.75" TextWrapping="Wrap" Margin="0,6,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Ui_Import_Export}" Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding ExportCommand}" Margin="0,0,10,0" />
                        <Button Content="{DynamicResource Ui_Import_ExportCsv}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding ExportCsvCommand}" Margin="0,0,10,0" />
                        <Button Content="{DynamicResource Ui_Import_ImportCsv}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding ImportCsvCommand}" Margin="0,0,10,0" />
                        <Button Content="{DynamicResource Ui_Import_CreateTemplate}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding CreateTemplateCommand}" />
                        <Button Content="{DynamicResource Ui_Import_BackupNow}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding BackupCommand}" Margin="0,0,10,0" />
                        <Button Content="{DynamicResource Ui_Import_Restore}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding RestoreCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Ui_Import_History}" FontSize="11" Opacity="0.6" />
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True"
                              Height="120" Margin="0,8,0,0" HeadersVisibility="Column"
                              Background="Transparent" RowBackground="Transparent" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Ui_Import_HistoryTime}" Binding="{Binding Waktu}" Width="160" />
                            <DataGridTextColumn Header="{DynamicResource Ui_Import_HistoryMode}" Binding="{Binding Mode}" Width="110" />
                            <DataGridTextColumn Header="{DynamicResource Ui_Import_HistoryFile}" Binding="{Binding Path}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>


