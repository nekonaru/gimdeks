<UserControl x:Class="GimDeks.App.Views.ImportExportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GimDeks.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock Text="Import / Export" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Import mengembalikan sheet Ringkasan sebagai pemeriksaan. Backup dibuat otomatis sebelum import."
                       Opacity="0.7" Margin="0,2,0,16" />

            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="IMPORT DARI EXCEL" FontSize="11" Opacity="0.6" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Path file .xlsx"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="Pilih File..." Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding BrowseCommand}" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Mode Import"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="150"
                                  ItemsSource="{Binding ImportModes}"
                                  SelectedItem="{Binding SelectedMode}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Lihat Pratinjau" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding PreviewCommand}" Margin="0,0,10,0" />
                        <Button Content="Impor Sekarang" Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding ImportCommand}" />
                    </StackPanel>

                    <ProgressBar Height="4" Margin="0,12,0,8" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusText}" Opacity="0.8" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding PreviewSummary}" FontWeight="SemiBold" Margin="0,12,0,4" />

                    <ItemsControl ItemsSource="{Binding SkippedSheets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., StringFormat='Dilewati: {0}'}" Opacity="0.7" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#FFB020" FontSize="12" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DataGrid ItemsSource="{Binding RingkasanRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="Transparent"
                              Margin="0,8,0,0"
                              MaxHeight="260"
                              Visibility="{Binding RingkasanRows.Count, Converter={StaticResource CountToVisibilityInverseConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sheet Ringkasan" Binding="{Binding Label}" Width="*" />
                            <DataGridTextColumn Header="Seharusnya" Binding="{Binding ExpectedText}" Width="170" />
                            <DataGridTextColumn Header="Terbaca" Binding="{Binding ActualText}" Width="170" />
                            <DataGridTextColumn Header="Hasil" Binding="{Binding ResultText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="EXPORT, BACKUP, RESTORE" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="Ekspor menghasilkan file .xlsx dengan rumus total yang aktif. Backup menyalin database saat ini; restore menggantikannya."
                               Opacity="0.75" TextWrapping="Wrap" Margin="0,6,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Ekspor ke Excel..." Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding ExportCommand}" Margin="0,0,10,0" />
                        <Button Content="Backup Sekarang" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding BackupCommand}" Margin="0,0,10,0" />
                        <Button Content="Pulihkan dari Backup..." Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding RestoreCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
