<UserControl x:Class="GimDeks.App.Views.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GimDeks.App.ViewModels">
    <Grid Margin="24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource Ui_Storage_Title}" FontSize="28" FontWeight="Bold" />
            <ListBox Grid.Row="1" Margin="0,12,0,8"
                     ItemsSource="{Binding Storages}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StorageListItem}">
                        <Border Padding="6,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding TipeLabel}" FontSize="10" Opacity="0.55" />
                                    <TextBlock Text="{Binding Storage.Nama}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding GameCountText}" FontSize="12" Opacity="0.75" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding TotalText}" TextAlignment="Right" VerticalAlignment="Center"
                                           FontSize="15" FontWeight="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="2" Content="{DynamicResource Ui_Storage_Add}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding AddStorageCommand}" />
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,44,0,0">
                <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                        Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Ui_Storage_Detail}" FontSize="11" Opacity="0.6" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding EditNama, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Ui_Storage_NameHint}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding TipeOptions}"
                                      SelectedItem="{Binding EditTipe, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="{DynamicResource Ui_Storage_Type}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding EditKapasitas, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Ui_Storage_Capacity}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            <TextBox Grid.Column="2" Text="{Binding EditBatas, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Ui_Storage_Limit}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding DriveOptions}"
                                      SelectedValue="{Binding SelectedDriveLetter, Mode=TwoWay}"
                                      SelectedValuePath="Letter"
                                      DisplayMemberPath="DisplayText"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="{DynamicResource Ui_Storage_Drive}" />
                            <TextBlock Grid.Column="2" Text="{Binding DriveStatusText}" VerticalAlignment="Center" Opacity="0.85" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{DynamicResource Ui_Storage_Save}" Style="{StaticResource MaterialDesignRaisedButton}"
                                    Command="{Binding SaveChangesCommand}" Margin="0,0,10,0" />
                            <Button Content="{DynamicResource Ui_Storage_Delete}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#FF8A8A" BorderBrush="#FF8A8A"
                                    Command="{Binding DeleteStorageCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Opacity="0.75" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                        Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Ui_Storage_Games}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                            <Button Content="{DynamicResource Ui_Storage_MoveSelected}" HorizontalAlignment="Right"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Padding="10,4"
                                    Command="{Binding MoveSelectedGamesCommand}" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding Games}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  MaxHeight="320"
                                  Margin="0,10,0,0"
                                  Background="Transparent"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#121A18"
                                  RowBackground="Transparent"
                                  HeadersVisibility="Column"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  SelectionChanged="DataGrid_OnSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Ui_Col_Name}" Binding="{Binding Game.Nama}" Width="*" />
                                <DataGridTextColumn Header="{DynamicResource Ui_Col_Size}" Binding="{Binding Game.UkuranGb, StringFormat=N1}" Width="110" />
                                <DataGridTextColumn Header="{DynamicResource Ui_Col_Status}" Binding="{Binding StatusText}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="16"
                        Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Ui_Storage_History}" FontSize="11" Opacity="0.6" />
                        <ItemsControl ItemsSource="{Binding Riwayat}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Opacity="0.85" Margin="0,2,0,2" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource Ui_Storage_PickLeft}"
                           Opacity="0.6" Margin="4,20,0,0"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
