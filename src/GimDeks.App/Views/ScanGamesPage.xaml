<UserControl x:Class="GimDeks.App.Views.ScanGamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Ui_Scan_Title}" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Grid.Row="0" Margin="0,42,0,0" Text="{DynamicResource Ui_Scan_Subtitle}" FontSize="13" Opacity="0.7" />

        <Border Grid.Row="1" Background="{StaticResource GimDeksCardAltGradient}" CornerRadius="14" Padding="16,14" Margin="0,12,0,14"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource GimDeksTileTeal}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Ui_Scan_Root}" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.8" />
                <ComboBox Grid.Column="1" materialDesign:HintAssist.Hint="{DynamicResource Ui_Scan_RootHint}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          ItemsSource="{Binding DriveChoices}" SelectedItem="{Binding SelectedDrive}"
                          DisplayMemberPath="DisplayText" Margin="0,0,8,0" />
                <TextBox Grid.Column="2" Width="190" materialDesign:HintAssist.Hint="{DynamicResource Ui_Scan_PathHint}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="{DynamicResource Ui_Scan_Scan}" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}"
                        Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="{DynamicResource Ui_Scan_Cancel}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding CancelScanCommand}" IsEnabled="{Binding IsScanning}" />
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Matches}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="False" HeadersVisibility="Column" Background="Transparent"
                  RowBackground="Transparent" AlternatingRowBackground="#121A18" GridLinesVisibility="Horizontal"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45" />
                <DataGridTextColumn Header="{DynamicResource Ui_Scan_Game}" Binding="{Binding Game.Nama}" Width="*" />
                <DataGridTextColumn Header="{DynamicResource Ui_Scan_Match}" Binding="{Binding MatchText}" Width="100" />
                <DataGridTextColumn Header="{DynamicResource Ui_Scan_Executable}" Binding="{Binding Executable.FileName}" Width="240" />
                <DataGridTextColumn Header="{DynamicResource Ui_Scan_Path}" Binding="{Binding Executable.Path}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="{StaticResource GimDeksCard}" CornerRadius="10" Padding="12,8" Margin="0,12,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SelectedCountText}" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.75" />
                    <Button Content="{DynamicResource Ui_Scan_Apply}" Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding ApplyCommand}" IsEnabled="{Binding HasMatches}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
