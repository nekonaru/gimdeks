<UserControl x:Class="GimDeks.App.Views.HealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GimDeks.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock Text="{DynamicResource Ui_Health_Title}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Ui_Health_Subtitle}" Opacity="0.7" Margin="0,2,0,16" />

            <Border Background="{StaticResource GimDeksCardAltGradient}" CornerRadius="14" Padding="18,14" Margin="0,0,0,18"
                    BorderThickness="0,1,0,0" BorderBrush="{StaticResource GimDeksTileTeal}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SummaryText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="{DynamicResource Ui_Health_Recheck}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding RefreshInternalCommand}" HorizontalAlignment="Right" Margin="24,0,0,0" Padding="12,3" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HealthIssue}">
                        <Border Background="{StaticResource GimDeksCard}" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
                                        Background="{StaticResource GimDeksAmber}"
                                        Visibility="{Binding Severity, Converter={StaticResource HealthSeverityToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="Bold" Foreground="#1F1300" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="{DynamicResource Ui_Health_Open}" Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding DataContext.OpenIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Margin="8,0,0,0" Padding="10,3" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{DynamicResource Ui_Health_Empty}" Opacity="0.6" FontSize="13" Margin="4,8,0,0"
                       Visibility="{Binding Issues.Count, Converter={StaticResource CountToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
