<UserControl x:Class="GimDeks.App.Views.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GimDeks.App.ViewModels">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Ui_Activity_Title}" FontSize="30" FontWeight="SemiBold" />
        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  Margin="0,16,0,0" HeadersVisibility="Column" Background="Transparent"
                  RowBackground="Transparent" AlternatingRowBackground="#121A18" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Ui_Activity_Time}" Binding="{Binding TimeText}" Width="150" />
                <DataGridTextColumn Header="{DynamicResource Ui_Activity_Action}" Binding="{Binding ActionText}" Width="140" />
                <DataGridTextColumn Header="{DynamicResource Ui_Activity_Detail}" Binding="{Binding Entry.Detail}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Opacity="0.6" Margin="0,8,0,0" />
    </Grid>
</UserControl>
