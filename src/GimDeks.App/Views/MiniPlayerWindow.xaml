<Window x:Class="GimDeks.App.Views.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:GimDeks.App.ViewModels"
        Title="{DynamicResource Ui_Mini_Title}" Width="340" Height="460"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Ui_Mini_Title}" FontSize="18" FontWeight="SemiBold" />
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Favorites}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MiniGameRow}">
                        <Border Background="{StaticResource GimDeksCard}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Game.Nama}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.6" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{DynamicResource Ui_Button_Launch}" Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Padding="8,2" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.7" />
            <Button Content="{DynamicResource Ui_Mini_Pick}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding PickRandomCommand}" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</Window>
