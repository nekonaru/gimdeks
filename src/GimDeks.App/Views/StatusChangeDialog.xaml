<Window x:Class="GimDeks.App.Views.StatusChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ubah Status"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Status baru" Margin="0,0,0,6" />
        <ComboBox x:Name="StatusComboBox" Margin="0,0,0,12" />
        <TextBlock Text="Alasan (opsional)" Margin="0,0,0,6" />
        <TextBox x:Name="AlasanTextBox" materialDesign:HintAssist.Hint="Contoh: dibeli fisik, tidak optimal dengan spek RAM" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Batal" Style="{StaticResource MaterialDesignFlatButton}" Click="CancelButton_OnClick" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Content="Simpan" Style="{StaticResource MaterialDesignRaisedButton}" Click="OkButton_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
