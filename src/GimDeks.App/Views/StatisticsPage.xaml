<UserControl x:Class="GimDeks.App.Views.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GimDeks.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock Text="{DynamicResource Ui_Statistics_Title}" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="{DynamicResource Ui_Statistics_Subtitle}" Opacity="0.7" Margin="0,2,0,16" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="18,14" Margin="0,0,12,0" MinWidth="150">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Ui_Dashboard_TotalGames}" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{Binding TotalGamesText}" FontSize="24" FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="18,14" Margin="0,0,12,0" MinWidth="170">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Ui_Dashboard_TotalSize}" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{Binding TotalSizeText}" FontSize="24" FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="18,14" MinWidth="220">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Ui_Statistics_Progress}" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{Binding CompletionText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding AverageSizeText}" Opacity="0.7" FontSize="13" Margin="0,0,0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Ui_Statistics_PerStorage}" FontSize="11" Opacity="0.6" />
                        <ItemsControl ItemsSource="{Binding StorageShares}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StorageShare}">
                                    <StackPanel Margin="0,5,0,5">
                                        <Grid>
                                            <TextBlock Text="{Binding Nama}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ShareText}" HorizontalAlignment="Right" Opacity="0.7" />
                                        </Grid>
                                        <ProgressBar Value="{Binding ShareFraction}" Maximum="1" Height="5"
                                                     Foreground="#2EE6C5" Background="#1E2A26" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding CountText}" Opacity="0.65" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Ui_Statistics_TopGames}" FontSize="11" Opacity="0.6" />
                        <ItemsControl ItemsSource="{Binding BiggestGames}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BiggestGame}">
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Nama}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                            <TextBlock Text="{Binding StorageName}" Opacity="0.6" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding UkuranText}" VerticalAlignment="Center"
                                                   FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding SummaryText}" Opacity="0.65" Margin="0,14,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
