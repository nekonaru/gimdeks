<UserControl x:Class="GimDeks.App.Views.GameListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GimDeks.App.ViewModels">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Ui_GameList_Title}" FontSize="30" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Margin="0,12,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="SearchBox" materialDesign:HintAssist.Hint="{DynamicResource Ui_GameList_SearchHint}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,8,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1" materialDesign:HintAssist.Hint="{DynamicResource Ui_Filter_Status}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}"
                          DisplayMemberPath="Label" />
                <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="{DynamicResource Ui_Filter_Storage}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding StorageOptions}"
                          SelectedItem="{Binding SelectedStorage}"
                          DisplayMemberPath="Label" />
                <ComboBox Grid.Column="3" materialDesign:HintAssist.Hint="{DynamicResource Ui_Filter_Tag}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding TagOptions}"
                          SelectedItem="{Binding SelectedTag}"
                          DisplayMemberPath="Label" />
                <ComboBox Grid.Column="4" materialDesign:HintAssist.Hint="{DynamicResource Ui_Filter_Selesai}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding SelesaiOptions}"
                          SelectedItem="{Binding SelectedSelesai}"
                          DisplayMemberPath="Label" />
                <TextBox Grid.Column="5" materialDesign:HintAssist.Hint="{DynamicResource Ui_Filter_MinGb}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,8,0"
                         Text="{Binding MinSize, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="6" materialDesign:HintAssist.Hint="{DynamicResource Ui_Filter_MaxGb}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,8,0"
                         Text="{Binding MaxSize, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="7" ToolTip="{DynamicResource Ui_Filter_Clear}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        AutomationProperties.Name="{DynamicResource Ui_Filter_Clear}"
                        Command="{Binding ClearFiltersCommand}">
                    <materialDesign:PackIcon Kind="FilterOff" />
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="{DynamicResource Ui_Button_ToggleView}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ToggleViewCommand}" Margin="0,0,8,0" />
                <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="{DynamicResource Ui_Filter_Sort}"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort}"
                          DisplayMemberPath="Label" Width="150" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Ui_Button_AdvancedSearch}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding OpenAdvancedSearchCommand}" Margin="0,0,8,0" />
                <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="{DynamicResource Ui_Advanced_Presets}"
                          ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                          DisplayMemberPath="Nama" Width="130" Margin="0,0,8,0" />
                <TextBox Width="100" materialDesign:HintAssist.Hint="{DynamicResource Ui_Advanced_PresetName}"
                         x:Name="PresetNameBox" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Ui_Advanced_SavePreset}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding SavePresetCommand}" CommandParameter="{Binding Text, ElementName=PresetNameBox}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Ui_Button_Add}" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding AddGameCommand}" Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                    <Button Content="{DynamicResource Ui_Button_Edit}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding EditGameCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Ui_Button_Detail}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding OpenDetailCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Ui_Button_Launch}" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding LaunchGameCommand}" Margin="0,0,8,0"
                        ToolTip="{DynamicResource Ui_Button_LaunchTooltip}" />
                <Button Content="{DynamicResource Ui_Button_MoveTo}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding MoveToStorageCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Ui_Button_ChangeStatus}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ChangeStatusCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Ui_Button_Selesai}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ToggleSelesaiCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0"
                        ToolTip="{DynamicResource Ui_Button_SelesaiTooltip}" />
                <Button Content="{DynamicResource Ui_Button_SplitVersion}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding SplitVersionsCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0"
                        ToolTip="{DynamicResource Ui_Button_SplitVersionTooltip}" />
                <Button Content="{DynamicResource Ui_Button_DownloadMissingCovers}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding DownloadMissingCoversCommand}" Margin="0,0,8,0"
                        ToolTip="{DynamicResource Ui_Button_DownloadMissingCoversTooltip}" />
                <Button Content="{DynamicResource Ui_Button_DownloadCover}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding DownloadCoversCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0"
                        ToolTip="{DynamicResource Ui_Button_DownloadCoverTooltip}" />
                <Button Content="{DynamicResource Ui_Button_Delete}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding DeleteGamesCommand}" IsEnabled="{Binding HasSelection}" Foreground="#FF8A8A" BorderBrush="#FF8A8A" />
                <Button Content="{DynamicResource Ui_GameList_ExportSelectedXlsx}" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding ExportSelectedExcelCommand}" IsEnabled="{Binding HasSelection}" Padding="8,3" />
                <Button Content="{DynamicResource Ui_GameList_ExportSelectedCsv}" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding ExportSelectedCsvCommand}" IsEnabled="{Binding HasSelection}" Padding="8,3" />
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="GamesGrid" Grid.Row="2"
                  Visibility="{Binding IsGridView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                  ItemsSource="{Binding Rows}"
                  AllowDrop="True"
                  PreviewDragOver="DataGrid_OnPreviewDragOver"
                  PreviewDrop="DataGrid_OnDrop"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#1F2A28"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#121A18"
                  HeadersVisibility="Column"
                  SelectionChanged="DataGrid_OnSelectionChanged"
                  MouseDoubleClick="DataGrid_OnMouseDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource Ui_Button_Launch}"
                              Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <MenuItem Header="{DynamicResource Ui_Button_Edit}"
                              Command="{Binding DataContext.EditGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              IsEnabled="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <MenuItem Header="{DynamicResource Ui_Button_MoveTo}"
                              Command="{Binding DataContext.MoveToStorageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              IsEnabled="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <MenuItem Header="{DynamicResource Ui_Button_ChangeStatus}"
                              Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              IsEnabled="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <MenuItem Header="{DynamicResource Ui_Button_SplitVersion}"
                              Command="{Binding DataContext.SplitVersionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              IsEnabled="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <MenuItem Header="{DynamicResource Ui_Button_Selesai}"
                              Command="{Binding DataContext.ToggleSelesaiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              IsEnabled="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <MenuItem Header="{DynamicResource Ui_Button_DownloadCover}"
                              Command="{Binding DataContext.DownloadCoversCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              IsEnabled="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Separator />
                    <MenuItem Header="{DynamicResource Ui_Button_Delete}"
                              Foreground="#FF8A8A"
                              Command="{Binding DataContext.DeleteGamesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              IsEnabled="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="{DynamicResource Ui_Col_Selesai}" Binding="{Binding Game.SelesaiMain}" IsReadOnly="True" Width="55" />
                <DataGridTemplateColumn Header="{DynamicResource Ui_Col_Favorite}" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Game.Favorit, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      Checked="FavoriteCheckBox_OnChanged"
                                      Unchecked="FavoriteCheckBox_OnChanged" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Rating}" Binding="{Binding RatingText}" Width="70" />
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Time}" Binding="{Binding TimeText}" Width="80" />
                <DataGridTemplateColumn Header="{DynamicResource Ui_Col_Cover}" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Game.Id, Converter={StaticResource GameIdToCoverConverter}}"
                                   Height="44" Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Name}" Binding="{Binding Game.Nama}" Width="*" />
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Version}" Binding="{Binding Game.Versi}" Width="100" />
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Size}" Binding="{Binding Game.UkuranGb, StringFormat=N1}" Width="110" />
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Status}" Binding="{Binding StatusText}" Width="135" />
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Played}" Binding="{Binding PlayText}" Width="110" />
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Storage}" Binding="{Binding StorageName}" Width="160" />
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Tag}" Binding="{Binding TagsText}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Rows}"
                      Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Left" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="156" Height="196" Margin="6" Padding="8"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <Border Height="112" CornerRadius="8" Background="#121A18">
                                <Image Source="{Binding Game.Id, Converter={StaticResource GameIdToCoverConverter}}"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="{Binding Game.Nama}" FontWeight="SemiBold" Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Game.Nama}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.7" />
                            <TextBlock Text="{Binding TimeText}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3" Margin="2,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SummaryText}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Opacity="0.85" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>


