<UserControl x:Class="GimDeks.App.Views.GameListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GimDeks.App.ViewModels">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Ui_GameList_Title}" FontSize="28" FontWeight="Bold" />

        <StackPanel Grid.Row="1" Margin="0,12,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="SearchBox" materialDesign:HintAssist.Hint="{DynamicResource Ui_GameList_SearchHint}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,8,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1" materialDesign:HintAssist.Hint="{DynamicResource Ui_Filter_Status}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}"
                          DisplayMemberPath="Label" />
                <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="{DynamicResource Ui_Filter_Storage}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding StorageOptions}"
                          SelectedItem="{Binding SelectedStorage}"
                          DisplayMemberPath="Label" />
                <ComboBox Grid.Column="3" materialDesign:HintAssist.Hint="{DynamicResource Ui_Filter_Tag}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding TagOptions}"
                          SelectedItem="{Binding SelectedTag}"
                          DisplayMemberPath="Label" />
                <ComboBox Grid.Column="4" materialDesign:HintAssist.Hint="{DynamicResource Ui_Filter_Selesai}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding SelesaiOptions}"
                          SelectedItem="{Binding SelectedSelesai}"
                          DisplayMemberPath="Label" />
                <TextBox Grid.Column="5" materialDesign:HintAssist.Hint="{DynamicResource Ui_Filter_MinGb}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,8,0"
                         Text="{Binding MinSize, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="6" materialDesign:HintAssist.Hint="{DynamicResource Ui_Filter_MaxGb}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,8,0"
                         Text="{Binding MaxSize, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="7" ToolTip="{DynamicResource Ui_Filter_Clear}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        AutomationProperties.Name="{DynamicResource Ui_Filter_Clear}"
                        Command="{Binding ClearFiltersCommand}">
                    <materialDesign:PackIcon Kind="FilterOff" />
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="{DynamicResource Ui_Button_Add}" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding AddGameCommand}" Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="{DynamicResource Ui_Button_Edit}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding EditGameCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Ui_Button_MoveTo}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding MoveToStorageCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Ui_Button_ChangeStatus}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ChangeStatusCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Ui_Button_Selesai}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ToggleSelesaiCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0"
                        ToolTip="{DynamicResource Ui_Button_SelesaiTooltip}" />
                <Button Content="{DynamicResource Ui_Button_SplitVersion}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding SplitVersionsCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0"
                        ToolTip="{DynamicResource Ui_Button_SplitVersionTooltip}" />
                <Button Content="{DynamicResource Ui_Button_DownloadCover}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding DownloadCoversCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,8,0"
                        ToolTip="{DynamicResource Ui_Button_DownloadCoverTooltip}" />
                <Button Content="{DynamicResource Ui_Button_Delete}" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding DeleteGamesCommand}" IsEnabled="{Binding HasSelection}" Foreground="#FF8A8A" BorderBrush="#FF8A8A" />
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="GamesGrid" Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#1F2A28"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#121A18"
                  HeadersVisibility="Column"
                  SelectionChanged="DataGrid_OnSelectionChanged"
                  MouseDoubleClick="DataGrid_OnMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="{DynamicResource Ui_Col_Selesai}" Binding="{Binding Game.SelesaiMain}" IsReadOnly="True" Width="55" />
                <DataGridTemplateColumn Header="{DynamicResource Ui_Col_Cover}" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Game.Id, Converter={StaticResource GameIdToCoverConverter}}"
                                   Height="44" Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Name}" Binding="{Binding Game.Nama}" Width="*" />
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Version}" Binding="{Binding Game.Versi}" Width="100" />
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Size}" Binding="{Binding Game.UkuranGb, StringFormat=N1}" Width="110" />
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Status}" Binding="{Binding StatusText}" Width="135" />
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Storage}" Binding="{Binding StorageName}" Width="160" />
                <DataGridTextColumn Header="{DynamicResource Ui_Col_Tag}" Binding="{Binding TagsText}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="2,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SummaryText}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Opacity="0.85" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>


