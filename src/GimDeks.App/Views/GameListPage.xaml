<UserControl x:Class="GimDeks.App.Views.GameListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GimDeks.App.ViewModels">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Daftar Game" FontSize="28" FontWeight="Bold" />

        <StackPanel Grid.Row="1" Margin="0,12,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Cari nama game atau versi"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,10,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1" materialDesign:HintAssist.Hint="Status"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,10,0"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}"
                          DisplayMemberPath="Label" />
                <ComboBox Grid.Column="2" materialDesign:HintAssist.Hint="Storage"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,10,0"
                          ItemsSource="{Binding StorageOptions}"
                          SelectedItem="{Binding SelectedStorage}"
                          DisplayMemberPath="Label" />
                <TextBox Grid.Column="3" materialDesign:HintAssist.Hint="Min GB"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,10,0"
                         Text="{Binding MinSize, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="4" materialDesign:HintAssist.Hint="Maks GB"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,10,0"
                         Text="{Binding MaxSize, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="5" ToolTip="Hapus semua filter"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding ClearFiltersCommand}">
                    <materialDesign:PackIcon Kind="FilterOff" />
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Tambah" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding AddGameCommand}" Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="Ubah" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding EditGameCommand}" Margin="0,0,8,0" />
                <Button Content="Pindah ke..." Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding MoveToStorageCommand}" Margin="0,0,8,0" />
                <Button Content="Ubah Status..." Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ChangeStatusCommand}" Margin="0,0,8,0" />
                <Button Content="Hapus" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding DeleteGamesCommand}" Foreground="#FF8A8A" BorderBrush="#FF8A8A" />
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#1F2A28"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#121A18"
                  HeadersVisibility="Column"
                  SelectionChanged="DataGrid_OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nama Game" Binding="{Binding Game.Nama}" Width="*" />
                <DataGridTextColumn Header="Versi" Binding="{Binding Game.Versi}" Width="90" />
                <DataGridTextColumn Header="Ukuran (GB)" Binding="{Binding Game.UkuranGb, StringFormat=N1}" Width="110" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="150" />
                <DataGridTextColumn Header="Storage" Binding="{Binding StorageName}" Width="190" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding SummaryText}" Opacity="0.7" Margin="2,8,0,0" FontSize="12" />
    </Grid>
</UserControl>

