<UserControl x:Class="GimDeks.App.Views.AutomationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:GimDeks.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock Text="{DynamicResource Ui_Auto_Title}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Ui_Auto_Subtitle}" Opacity="0.7" Margin="0,2,0,16" />

            <Border Background="{StaticResource GimDeksCard}" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Ui_Auto_NewRule}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Ui_Auto_NameHint}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Fields}" SelectedItem="{Binding NewField}"
                                  materialDesign:HintAssist.Hint="{DynamicResource Ui_Auto_Field}" />
                        <ComboBox Grid.Column="4" ItemsSource="{Binding Operators}" SelectedItem="{Binding NewOperator}"
                                  materialDesign:HintAssist.Hint="{DynamicResource Ui_Auto_Operator}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Ui_Auto_Value}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Actions}" SelectedItem="{Binding NewAction}"
                                  materialDesign:HintAssist.Hint="{DynamicResource Ui_Auto_Action}" />
                        <TextBox Grid.Column="4" Text="{Binding NewArgument, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Ui_Auto_Argument}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{DynamicResource Ui_Settings_AddField}" Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding AddCommand}" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Ui_Auto_Run}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding RunCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AutomationRow}">
                        <Border Background="{StaticResource GimDeksCardAlt}" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Content="{DynamicResource Ui_Auto_Toggle}" Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Padding="8,2" />
                                <Button Grid.Column="2" Content="{DynamicResource Ui_Button_Delete}" Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Padding="8,2" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding StatusText}" Opacity="0.6" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
