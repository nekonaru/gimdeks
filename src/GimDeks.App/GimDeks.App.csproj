<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>GimDeks.App</RootNamespace>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.1</AssemblyVersion>
    <FileVersion>1.6.0.1</FileVersion>
    <ApplicationIcon>assets\gimdeks.ico</ApplicationIcon>
    <AssemblyName>GimDeks</AssemblyName>
    <Company>Nicolas Dwi Dharma</Company>
    <Product>GimDeks</Product>
    <Description>Pengganti file Excel koleksi game: kelola koleksi game lintas drive dengan hitungan otomatis.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GimDeks.Core\GimDeks.Core.csproj" />
    <ProjectReference Include="..\GimDeks.Data\GimDeks.Data.csproj" />
    <ProjectReference Include="..\GimDeks.Excel\GimDeks.Excel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\gimdeks-mark.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\gimdeks.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\gimdeks-lockup-teal.png" CopyToOutputDirectory="PreserveNewest">
      <Link>assets\gimdeks-lockup-teal.png</Link>
    </Content>
    <Content Include="..\..\assets\gimdeks-lockup-dark.png" CopyToOutputDirectory="PreserveNewest">
      <Link>assets\gimdeks-lockup-dark.png</Link>
    </Content>
    <Content Include="..\..\assets\gimdeks-lockup-light.png" CopyToOutputDirectory="PreserveNewest">
      <Link>assets\gimdeks-lockup-light.png</Link>
    </Content>
  </ItemGroup>

</Project>



